<% content_for :title, t("users.edit.title") %>

<%= render "shared/topbar", title: t("users.edit.title"),
    subtitle: breadcrumb([t("users.index.title"), users_path],
                          [@user.username, user_path(@user)],
                          [t("users.edit.title"), nil]) %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", user: @user %>
    </div>
  </div>
</div>
