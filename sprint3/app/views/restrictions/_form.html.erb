<%= form_with(model: restriction) do |form| %>
  <%= render "shared/form_errors", object: restriction %>

  <div class="field">
    <%= form.label :name, t("restrictions.form.name"), class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <div class="field">
    <%= form.label :description, t("restrictions.form.description"), class: "label" %>
    <%= form.text_area :description, class: "textarea", rows: 4 %>
  </div>

  <div class="field">
    <%= form.label :restriction_type, t("restrictions.form.restriction_type"), class: "label" %>
    <%= form.select :restriction_type,
                    Restriction.restriction_types.keys.map { |k| [t("restrictions.types.#{k}"), k] },
                    {}, class: "select" %>
    <%# DESIGN-GAP: design splits into 4 kinds (al·lèrgens / intoleràncies / religioses /
        preferències) as explanatory cards with implications. Only 2 enum values exist. %>
  </div>

  <div class="field">
    <%= form.label :bg_color, t("restrictions.form.bg_color"), class: "label" %>
    <%= form.color_field :bg_color, class: "input", value: restriction.bg_color || "#cccccc" %>
  </div>

  <div class="field">
    <%= form.label :icon_svg, t("restrictions.form.icon_svg"), class: "label" %>
    <%= form.text_area :icon_svg, class: "textarea", id: "restriction_icon_svg", rows: 4 %>
  </div>

  <%# DESIGN-GAP: design shows a "short code" (monospace, max 6 chars), severity chips,
      and toggles for "Visible al cambrer" and "Reglamentari EFSA". None of those fields
      exist on Restriction. %>

  <div class="row mt-4">
    <%= form.submit t("restrictions.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("restrictions.form.cancel"), restrictions_path, class: "btn btn-secondary" %>
  </div>
<% end %>
