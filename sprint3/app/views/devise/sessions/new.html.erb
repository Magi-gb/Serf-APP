<h2 class="login-title"><%= t("sessions.new.title") %></h2>
<p class="login-subtitle"><%= t("sessions.new.subtitle") %></p>

<%= form_for(resource, as: resource_name, url: session_path(resource_name), html: { class: "login-form" }) do |f| %>
  <div class="field">
    <%= f.label :username, t("users.form.username"), class: "label" %>
    <%= f.text_field :username,
        autofocus: true,
        autocomplete: "username",
        placeholder: t("users.index.search_placeholder"),
        class: "input" %>
  </div>

  <div class="field">
    <%= f.label :password, t("users.form.password"), class: "label" %>
    <%= f.password_field :password,
        autocomplete: "current-password",
        placeholder: "••••••••",
        class: "input" %>
  </div>

  <%= f.submit t("sessions.new.submit"), class: "btn btn-primary btn-block login-submit" %>
<% end %>

<div class="notice notice-info mt-4" role="note">
  <span class="notice-icon"><%= serf_icon(:shield) %></span>
  <div>
    <div class="notice-body"><%= t("sessions.new.authorized_only_note") %></div>
  </div>
</div>
