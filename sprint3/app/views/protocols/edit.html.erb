<% content_for :title, t("protocols.edit.title") %>

<%= render "shared/topbar", title: t("protocols.edit.title"),
    subtitle: breadcrumb([t("protocols.index.title"), protocols_path],
                          [@protocol.name, protocol_path(@protocol)],
                          [t("protocols.edit.title"), nil]) %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", protocol: @protocol %>
    </div>
  </div>
</div>
