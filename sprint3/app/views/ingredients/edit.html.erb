<% content_for :title, t("ingredients.edit.title") %>

<%= render "shared/topbar", title: t("ingredients.edit.title"),
    subtitle: breadcrumb([t("ingredients.index.title"), ingredients_path],
                          [@ingredient.name, ingredient_path(@ingredient)],
                          [t("ingredients.edit.title"), nil]) %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", ingredient: @ingredient, restrictions: @restrictions %>
    </div>
  </div>
</div>
