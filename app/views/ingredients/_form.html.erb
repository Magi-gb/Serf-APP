<%= form_with(model: ingredient, class: "ingredient-form") do |f| %>
  <% if ingredient.errors.any? %>
    <div class="form-errors">
      <ul>
        <% ingredient.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, t("ingredients.form.name"), class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>

  <fieldset class="form-fieldset">
    <legend class="form-legend"><%= t("ingredients.form.restrictions") %></legend>

    <div class="restrictions-section">
      <h3><%= t("ingredients.form.intolerance_allergies") %></h3>
      <div class="restrictions-group">
        <% restrictions.select { |r| r.intolerance_allergy? }.each do |restriction| %>
          <label class="form-checkbox">
            <%= f.check_box :restriction_ids, { multiple: true }, restriction.id, nil %>
            <span class="checkbox-label"><%= restriction.name %></span>
          </label>
        <% end %>
      </div>
    </div>

    <div class="restrictions-section">
      <h3><%= t("ingredients.form.religious_restrictions") %></h3>
      <div class="restrictions-group">
        <% restrictions.select { |r| r.religious? }.each do |restriction| %>
          <label class="form-checkbox">
            <%= f.check_box :restriction_ids, { multiple: true }, restriction.id, nil %>
            <span class="checkbox-label"><%= restriction.name %></span>
          </label>
        <% end %>
      </div>
    </div>
  </fieldset>

  <div class="form-actions">
    <%= f.submit ingredient.persisted? ? t("ingredients.form.submit_update") : t("ingredients.form.submit_create"), class: "btn btn--primary" %>
  </div>
<% end %>

