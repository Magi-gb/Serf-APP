<%= form_with(model: ingredient) do |form| %>
  <%= render "shared/form_errors", object: ingredient %>

  <div class="field">
    <%= form.label :name, t("ingredients.form.name"), class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <div class="field">
    <%= form.label :description, t("ingredients.form.description"), class: "label" %>
    <%= form.text_area :description, class: "textarea", rows: 4 %>
  </div>

  <fieldset class="field picker"
            data-controller="picker"
            data-picker-singular-value="<%= t("pickers.selected_one") %>"
            data-picker-plural-value="<%= t("pickers.selected_other", count: '%{count}') %>">
    <legend class="label"><%= t("ingredients.form.restrictions") %></legend>

    <div class="picker-toolbar">
      <div class="picker-search search">
        <span class="search-icon"><%= serf_icon(:search) %></span>
        <input type="search"
               class="input"
               placeholder="<%= t("pickers.search_placeholder") %>"
               data-picker-target="search"
               data-action="input->picker#refresh keydown->picker#preventSubmit">
      </div>
      <span class="picker-count" data-picker-target="count"><%= t("pickers.selected_other", count: 0) %></span>
      <button type="button"
              class="chip"
              aria-pressed="false"
              data-picker-target="onlySelected"
              data-action="click->picker#toggleOnlySelected">
        <%= t("pickers.only_selected") %>
      </button>
    </div>

    <%
      group_labels = {
        intolerance_allergy: [ t("ingredients.form.intolerance_allergies"), "allergen" ],
        diet: [ t("ingredients.form.diet_restrictions"), "diet" ],
        preference: [ t("ingredients.form.preference_restrictions"), "preference" ]
      }
    %>
    <% group_labels.each do |type, (label, tag_kind)| %>
      <% group = restrictions.select { |r| r.restriction_type == type.to_s } %>
      <% next if group.empty? %>
      <div class="picker-group" data-picker-group>
        <div class="picker-group-label">
          <span class="tag-dot" style="background: var(--tag-<%= tag_kind %>);"></span>
          <%= label %>
        </div>
        <div class="checkbox-cards">
          <% group.each do |restriction| %>
            <% search_text = [ restriction.name, t("restrictions.types.#{restriction.restriction_type}") ].join(" ") %>
            <label class="checkbox-card"
                   data-picker-target="item"
                   data-search-text="<%= search_text %>">
              <%= form.check_box :restriction_ids,
                                  { multiple: true, data: { action: "change->picker#refresh" } },
                                  restriction.id, nil %>
              <span><%= restriction.name %></span>
              <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= t("restrictions.types.#{restriction.restriction_type}") %></span>
            </label>
          <% end %>
        </div>
      </div>
    <% end %>

    <div class="picker-empty" data-picker-target="empty" hidden><%= t("pickers.none") %></div>

    <%# DESIGN-GAP: design groups restrictions into 4 buckets with an "EFSA Annex II" badge.
        Current enum has intolerance_allergy + diet + preference. EFSA flag not yet implemented. %>
  </fieldset>

  <div class="row mt-4">
    <%= form.submit ingredient.persisted? ? t("ingredients.form.submit_update") : t("ingredients.form.submit_create"),
                    class: "btn btn-primary" %>
    <%= link_to t("restrictions.form.cancel"), ingredients_path, class: "btn btn-secondary" %>
  </div>
<% end %>
