<%= form_with(model: @ingredient, class: "ingredient-form") do |f| %>

  <% if @ingredient.errors.any? %>
    <div class="form-errors">
      <ul>
        <% @ingredient.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :name, "Nom", class: "form-label" %>
    <%= f.text_field :name, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :description, "Descripció", class: "form-label" %>
    <%= f.text_area :description, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= f.submit @ingredient.persisted? ? "Actualitzar ingredient" : "Crear ingredient",
                 class: "btn btn--primary" %>
  </div>

<% end %>

