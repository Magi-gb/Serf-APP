<% content_for :title, t("ingredients.index.title") %>

<%= render "shared/topbar", title: t("ingredients.index.title") do %>
  <%= form_with url: ingredients_path, method: :get, local: true, class: "search" do |f| %>
    <span class="search-icon"><%= serf_icon(:search) %></span>
    <%= f.search_field :search, value: params[:search], placeholder: t("ingredients.index.search_placeholder"), class: "input" %>
  <% end %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= link_to new_ingredient_path, class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:plus) %><%= t("ingredients.index.new_ingredient") %>
    <% end %>
  <% end %>
<% end %>

<div class="content">
  <% if @ingredients.any? %>
    <div class="card">
      <% @ingredients.each do |ingredient| %>
        <%= link_to ingredient_path(ingredient), class: "card-row is-link" do %>
          <div class="grow">
            <div class="strong"><%= ingredient.name %></div>
            <% if ingredient.restrictions.any? %>
              <div class="row mt-2">
                <% ingredient.restrictions.each do |restriction| %>
                  <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
                <% end %>
              </div>
            <% else %>
              <div class="muted mt-2"><%= t("ingredients.index.no_restrictions") %></div>
            <% end %>
          </div>
          <%# DESIGN-GAP: design shows "in N dishes" + "last edited by X". %>
          <%# We don't track who-last-edited (no PaperTrail / authored_at). %>
          <span class="muted"><%= serf_icon(:chevron) %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state"><%= t("ingredients.index.no_ingredients") %></div>
  <% end %>
</div>
