<% content_for :title, @ingredient.name %>

<%= render "shared/topbar", title: @ingredient.name,
    subtitle: breadcrumb([t("ingredients.index.title"), ingredients_path], [@ingredient.name, nil]) do %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= button_to ingredient_path(@ingredient), method: :delete,
                  class: "btn btn-secondary btn-sm",
                  form: { data: { turbo_confirm: t("ingredients.show.confirm_delete") } } do %>
      <%= serf_icon(:trash) %><%= t("ingredients.show.delete") %>
    <% end %>
    <%= link_to edit_ingredient_path(@ingredient), class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:edit) %><%= t("ingredients.show.edit") %>
    <% end %>
  <% end %>
<% end %>

<% has_allergen = @ingredient.restrictions.any?(&:intolerance_allergy?) %>

<div class="content show-grid">
  <div class="col">
    <%# Hero %>
    <div class="card">
      <div class="card-body row">
        <span class="avatar avatar-lg" style="--avatar-bg: <%= has_allergen ? 'var(--brand-red)' : 'var(--accent-green)' %>;">
          <%= serf_icon(:leaf, size: 28) %>
        </span>
        <div class="grow">
          <div class="row">
            <div class="strong"><%= @ingredient.name %></div>
            <% if has_allergen %>
              <span class="tag tag-allergen">
                <%= serf_icon(:alert) %>
                <%= t("ingredients.show.allergen_badge") %>
              </span>
            <% end %>
          </div>
          <% if @ingredient.description.present? %>
            <p class="muted mt-2 mb-0"><%= @ingredient.description %></p>
          <% end %>
        </div>
      </div>
    </div>

    <%# Restrictions cards (linked) %>
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= t("ingredients.show.restrictions") %>
          <span class="muted"> · <%= @ingredient.restrictions.size %></span>
        </h3>
      </div>
      <div class="card-body">
        <% if @ingredient.restrictions.any? %>
          <div class="col">
            <% @ingredient.restrictions.each do |restriction| %>
              <%= link_to restriction_path(restriction), class: "restriction-card" do %>
                <span class="restr-bubble restr-bubble-sm" style="--restr-bg: <%= restriction.bg_color.presence || 'var(--accent-green-soft)' %>; --restr-fg: var(--text-on-brand);">
                  <% if restriction.icon_svg.present? %>
                    <%= restriction_icon_svg(restriction.icon_svg) %>
                  <% else %>
                    <%= restriction.name.first(3).upcase %>
                  <% end %>
                </span>
                <div class="grow">
                  <div class="strong"><%= restriction.name %></div>
                  <div class="muted mt-1"><%= t("restrictions.types.#{restriction.restriction_type}") %></div>
                </div>
                <span class="muted"><%= serf_icon(:chevron) %></span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="muted text-center"><%= t("ingredients.show.no_restrictions") %></div>
        <% end %>
      </div>
    </div>

    <%# Dishes that contain this ingredient %>
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= t("ingredients.show.used_in_dishes") %>
          <span class="muted"> · <%= @ingredient.dishes.size %></span>
        </h3>
      </div>
      <div class="card-body">
        <% if @ingredient.dishes.any? %>
          <div class="grid grid-2">
            <% @ingredient.dishes.each do |dish| %>
              <%= link_to dish_path(dish), class: "dish-mini" do %>
                <div class="dish-mini-thumb"><%= dish.name.first(2).upcase %></div>
                <div class="grow">
                  <div class="strong"><%= dish.name %></div>
                  <div class="muted mt-1"><%= t("dishes.types.#{dish.dish_type}") %></div>
                </div>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="muted text-center"><%= t("ingredients.show.not_used_in_dishes") %></div>
        <% end %>
      </div>
    </div>

    <%# Alternatives (substitutable ingredients) %>
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= t("ingredients.show.alternatives_title") %>
          <span class="muted"> · <%= @ingredient.alternatives.size %></span>
        </h3>
      </div>
      <div class="card-body col">
        <% if @ingredient.alternatives.any? %>
          <% @ingredient.alternatives.order(:name).each do |alternative| %>
            <div class="row alternative-row">
              <%= link_to ingredient_path(alternative), class: "grow alternative-link" do %>
                <span class="avatar avatar-sm" style="--avatar-bg: var(--accent-green);">
                  <%= serf_icon(:leaf) %>
                </span>
                <span class="strong"><%= alternative.name %></span>
              <% end %>
              <% if current_user.admin? || current_user.kitchen_manager? %>
                <%= button_to ingredient_alternative_path(@ingredient, alternative),
                              method: :delete,
                              class: "btn btn-secondary btn-sm",
                              form: { data: { turbo_confirm: t("ingredients.show.confirm_remove_alternative") } } do %>
                  <%= serf_icon(:trash) %><%= t("ingredients.show.remove_alternative") %>
                <% end %>
              <% end %>
            </div>
          <% end %>
        <% else %>
          <div class="muted text-center"><%= t("ingredients.show.no_alternatives") %></div>
        <% end %>

        <% if (current_user.admin? || current_user.kitchen_manager?) && @alternative_ingredients&.any? %>
          <div class="divider"></div>
          <div class="strong"><%= t("ingredients.show.add_alternative_title") %></div>
          <%= form_with url: ingredient_alternatives_path(@ingredient), scope: :ingredient_alternative, class: "row" do |f| %>
            <div class="grow">
              <%= f.label :alternative_id, t("ingredients.show.add_alternative_label"), class: "label" %>
              <%= f.select :alternative_id,
                           options_from_collection_for_select(@alternative_ingredients, :id, :name),
                           { prompt: t("ingredients.show.add_alternative_prompt") },
                           class: "select" %>
            </div>
            <%= f.submit t("ingredients.show.add_alternative_submit"), class: "btn btn-primary" %>
          <% end %>
        <% elsif current_user.admin? || current_user.kitchen_manager? %>
          <% unless @ingredient.alternatives.any? %>
            <div class="muted text-center"><%= t("ingredients.show.no_available_alternatives") %></div>
          <% end %>
        <% end %>
      </div>
    </div>
  </div>

  <%# Sidebar %>
  <aside class="show-side">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= t("ingredients.show.details") %></h3></div>
      <div class="card-body col">
        <div class="detail-field">
          <div class="detail-field-label">ID</div>
          <div class="detail-field-value">#<%= @ingredient.id.to_s.rjust(4, "0") %></div>
        </div>
        <div class="detail-field">
          <div class="detail-field-label"><%= t("ingredients.show.linked_dishes") %></div>
          <div class="detail-field-value"><%= @ingredient.dishes.size %></div>
        </div>
        <div class="detail-field">
          <div class="detail-field-label"><%= t("ingredients.show.linked_restrictions") %></div>
          <div class="detail-field-value"><%= @ingredient.restrictions.size %></div>
        </div>
      </div>
    </div>

    <% if @ingredient.dishes.any? %>
      <div class="card">
        <div class="card-body">
          <div class="strong"><%= t("ingredients.show.did_you_know") %></div>
          <p class="muted mt-2 mb-0"><%= t("ingredients.show.delete_warning", count: @ingredient.dishes.size) %></p>
        </div>
      </div>
    <% end %>
  </aside>
</div>
