<% content_for :title, @ingredient.name %>

<%= render "shared/topbar", title: @ingredient.name,
    subtitle: breadcrumb([t("ingredients.index.title"), ingredients_path], [@ingredient.name, nil]) do %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= button_to ingredient_path(@ingredient), method: :delete,
                  class: "btn btn-secondary btn-sm",
                  form: { data: { turbo_confirm: t("ingredients.show.confirm_delete") } } do %>
      <%= serf_icon(:trash) %><%= t("ingredients.show.delete") %>
    <% end %>
    <%= link_to edit_ingredient_path(@ingredient), class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:edit) %><%= t("ingredients.show.edit") %>
    <% end %>
  <% end %>
<% end %>

<% has_allergen = @ingredient.restrictions.any?(&:intolerance_allergy?) %>
<% has_restriction = @ingredient.restrictions.any? %>

<div class="content show-grid">
  <div class="col">
    <%# Hero %>
    <div class="card">
      <div class="card-body row">
        <span class="avatar avatar-lg" style="--avatar-bg: <%= has_restriction ? 'var(--brand-red)' : 'var(--accent-green)' %>;">
          <%= serf_icon(:leaf, size: 28) %>
        </span>
        <div class="grow">
          <div class="row">
            <div class="strong"><%= @ingredient.name %></div>
            <% if has_allergen %>
              <span class="tag tag-allergen">
                <%= serf_icon(:alert) %>
                <%= t("ingredients.show.allergen_badge") %>
              </span>
            <% end %>
          </div>
          <% if @ingredient.description.present? %>
            <p class="muted mt-2 mb-0"><%= @ingredient.description %></p>
          <% end %>
        </div>
      </div>
    </div>

    <%# Restrictions cards (linked) %>
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= t("ingredients.show.restrictions") %>
          <span class="muted"> · <%= @ingredient.restrictions.size %></span>
        </h3>
      </div>
      <div class="card-body">
        <% if @ingredient.restrictions.any? %>
          <div class="col">
            <% @ingredient.restrictions.each do |restriction| %>
              <%= link_to restriction_path(restriction), class: "restriction-card" do %>
                <span class="restr-bubble restr-bubble-sm">
                  <%= restriction.name.first(3).upcase %>
                </span>
                <div class="grow">
                  <div class="strong"><%= restriction.name %></div>
                  <div class="row wrap gap-1 mt-1">
                    <span class="muted"><%= t("restrictions.types.#{restriction.restriction_type}") %></span>
                    <span class="tag tag-severity-<%= restriction.severity %>">
                      <span class="tag-dot"></span>
                      <%= t("restrictions.severity.#{restriction.severity}") %>
                    </span>
                  </div>
                </div>
                <span class="muted"><%= serf_icon(:chevron) %></span>
              <% end %>
            <% end %>
          </div>
        <% else %>
          <div class="muted text-center"><%= t("ingredients.show.no_restrictions") %></div>
        <% end %>
      </div>
    </div>

    <%# Dishes that contain this ingredient %>
    <div class="card">
      <div class="card-header">
        <h3 class="card-title">
          <%= t("ingredients.show.used_in_dishes") %>
          <span class="muted"> · <%= @dishes.size %></span>
        </h3>
      </div>
      <div class="card-body">
        <% if @dishes.any? %>
          <div class="grid grid-2">
            <%= render partial: "shared/dish_mini", collection: @dishes, as: :dish %>
          </div>
        <% else %>
          <div class="muted text-center"><%= t("ingredients.show.not_used_in_dishes") %></div>
        <% end %>
      </div>
    </div>

  </div>

  <%# Sidebar %>
  <aside class="show-side">
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= t("ingredients.show.details") %></h3></div>
      <div class="card-body col">
        <div class="detail-field">
          <div class="detail-field-label">ID</div>
          <div class="detail-field-value">#<%= @ingredient.id.to_s.rjust(4, "0") %></div>
        </div>
        <div class="detail-field">
          <div class="detail-field-label"><%= t("ingredients.show.linked_dishes") %></div>
          <div class="detail-field-value"><%= @ingredient.dishes.size %></div>
        </div>
        <div class="detail-field">
          <div class="detail-field-label"><%= t("ingredients.show.linked_restrictions") %></div>
          <div class="detail-field-value"><%= @ingredient.restrictions.size %></div>
        </div>
      </div>
    </div>

    <% if @ingredient.dishes.any? %>
      <div class="card">
        <div class="card-body">
          <div class="strong"><%= t("ingredients.show.did_you_know") %></div>
          <p class="muted mt-2 mb-0"><%= t("ingredients.show.delete_warning", count: @ingredient.dishes.size) %></p>
        </div>
      </div>
    <% end %>
  </aside>
</div>
