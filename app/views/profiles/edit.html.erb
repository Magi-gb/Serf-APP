<div class="password-form">
  <h1><%= t("profile.edit.title") %></h1>

  <%= form_with(scope: :profile, url: profile_path, method: :patch, class: "user-form") do |f| %>
    <% if current_user.errors.any? %>
      <div class="form-errors">
        <ul>
          <% current_user.errors.full_messages.each do |message| %>
            <li><%= message %></li>
          <% end %>
        </ul>
      </div>
    <% end %>

    <div class="form-group">
      <%= f.label :current_password, t("profile.edit.current_password"), class: "form-label" %>
      <%= f.password_field :current_password, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password, t("profile.edit.new_password"), class: "form-label" %>
      <%= f.password_field :password, class: "form-input" %>
    </div>

    <div class="form-group">
      <%= f.label :password_confirmation, t("profile.edit.new_password_confirmation"), class: "form-label" %>
      <%= f.password_field :password_confirmation, class: "form-input" %>
    </div>

    <div class="form-actions">
      <%= f.submit t("profile.edit.submit"), class: "btn btn--primary" %>
    </div>
  <% end %>
</div>
