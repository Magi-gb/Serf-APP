<% content_for :title, t("profile.edit.title") %>

<%= render "shared/topbar", title: t("profile.edit.title"),
    subtitle: breadcrumb([t("profile.show.title"), profile_path], [t("profile.edit.title"), nil]) %>

<div class="content">
  <div class="card profile-card">
    <div class="card-body">
      <%= form_with(scope: :profile, url: profile_path, method: :patch) do |f| %>
        <%= render "shared/form_errors", object: current_user %>

        <div class="field">
          <%= f.label :current_password, t("profile.edit.current_password"), class: "label" %>
          <%= f.password_field :current_password, class: "input", autocomplete: "current-password" %>
        </div>

        <div class="field">
          <%= f.label :password, t("profile.edit.new_password"), class: "label" %>
          <%= f.password_field :password, class: "input", autocomplete: "new-password" %>
        </div>

        <div class="field">
          <%= f.label :password_confirmation, t("profile.edit.new_password_confirmation"), class: "label" %>
          <%= f.password_field :password_confirmation, class: "input", autocomplete: "new-password" %>
        </div>

        <div class="row mt-4">
          <%= f.submit t("profile.edit.submit"), class: "btn btn-primary" %>
          <%= link_to t("dishes.form.cancel"), profile_path, class: "btn btn-secondary" %>
        </div>
      <% end %>
    </div>
  </div>
</div>
