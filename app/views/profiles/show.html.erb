<div class="profile-card">
  <h1><%= t("profile.show.title") %></h1>

  <div class="profile-field">
    <span class="profile-field__label"><%= t("profile.show.username") %></span>
    <span class="profile-field__value"><%= current_user.username %></span>
  </div>

  <div class="profile-field">
    <span class="profile-field__label"><%= t("profile.show.role") %></span>
    <span class="profile-field__value"><%= t("users.roles.#{current_user.role}") %></span>
  </div>

  <div class="profile-actions">
    <%= link_to t("profile.show.change_password"), edit_profile_path, class: "btn btn--primary" %>
  </div>
</div>
