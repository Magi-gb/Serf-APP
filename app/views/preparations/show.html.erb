<% content_for :title, @preparation.name %>

<%= render "shared/topbar", title: @preparation.name,
    subtitle: breadcrumb([t("preparations.index.title"), preparations_path], [@preparation.name, nil]) do %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= link_to edit_preparation_path(@preparation), class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:edit) %><%= t("preparations.show.edit") %>
    <% end %>
  <% end %>
<% end %>

<div class="content col">
  <div class="card">
    <div class="card-body row">
      <span class="avatar avatar-lg" style="--avatar-bg: var(--accent-blue);">
        <%= serf_icon(:list, size: 28) %>
      </span>
      <div class="grow">
        <h2 class="strong"><%= @preparation.name %></h2>
        <p class="muted">
          <%= t("preparations.show.time_minutes") %>: <strong><%= @preparation.time_minutes %> min</strong>
          &bull;
          <%= t("preparations.show.difficulty") %>:
          <%
            difficulty_class = case @preparation.difficulty
              when "easy" then "preference"
              when "medium" then "intolerance"
              when "hard" then "allergen"
            end
          %>
          <span class="tag tag-<%= difficulty_class %>" style="display: inline-flex;"><%= t("preparations.difficulties.#{@preparation.difficulty}") %></span>
        </p>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("preparations.show.dish") %></h3></div>
    <div class="card-body">
      <% if @preparation.dish.present? %>
        <%= link_to @preparation.dish.name, dish_path(@preparation.dish), class: "strong" %>
      <% else %>
        <span class="muted"><%= t("preparations.show.no_dish") %></span>
      <% end %>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= Preparation.human_attribute_name(:description) %></h3></div>
    <div class="card-body">
      <%= simple_format(@preparation.description.presence || t("preparations.show.no_description"), {}, sanitize: false) %>
    </div>
  </div>
</div>
