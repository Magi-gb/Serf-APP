<% content_for :title, t("plats.index.title") %>

<div class="page-card">
  <div class="page-header">
    <h1 class="serf-page-title"><%= t("plats.index.title") %></h1>
  </div>

  <div class="index-toolbar">
    <%= render "shared/search_bar", url: plats_path, placeholder: t("plats.index.search_placeholder") %>
    <% if current_user.admin? || current_user.kitchen_manager? %>
      <%= link_to t("plats.index.new_plat"), new_plat_path, class: "btn-pill btn-pill-primary" %>
    <% end %>
  </div>

  <div class="list-card-group">
    <% if @plats.any? %>
      <% @plats.each do |plat| %>
        <%= link_to plat_path(plat), class: "list-card" do %>
          <div class="list-card-info">
            <span class="list-card-title"><%= plat.name %></span>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="empty-state text-center"><%= t("plats.index.no_plats") %></p>
    <% end %>
  </div>
</div>
