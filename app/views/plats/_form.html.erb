<%= form_with(model: plat, class: "form-container") do |form| %>
  <% if plat.errors.any? %>
    <div class="alert-error">
      <h3><%= t("errors.form_header", count: plat.errors.count) %></h3>
      <ul>
        <% plat.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, t("plats.form.name") %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :description, t("plats.form.description") %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="form-group">
    <%= form.label :tipusPlat, t("plats.form.tipus_plat") %>
    <%= form.select :tipusPlat,
      Plat.tipusPlats.keys.map { |k| [t("plats.types.#{k}"), k] },
      {},
      class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :ingredient_ids, t("plats.form.ingredients") %>
    <div class="checkbox-group">
      <% @ingredients.each do |ingredient| %>
        <div class="checkbox-item">
          <%= form.check_box :ingredient_ids, { multiple: true, include_hidden: false }, ingredient.id, nil %>
          <%= form.label "plat_ingredient_ids_#{ingredient.id}", ingredient.name %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit plat.new_record? ? t("plats.form.submit_create") : t("plats.form.submit_update"), class: "btn-primary" %>
    <%= link_to t("plats.form.cancel"), plats_path, class: "btn-secondary" %>
  </div>
<% end %>
