<% content_for :title, t("dishes.index.title") %>
<% view = params[:view].presence || "grid" %>

<%= render "shared/topbar", title: t("dishes.index.title") do %>
  <%= form_with url: dishes_path, method: :get, local: true, class: "search" do |f| %>
    <span class="search-icon"><%= serf_icon(:search) %></span>
    <%= f.search_field :search, value: params[:search], placeholder: t("dishes.index.search_placeholder"), class: "input" %>
  <% end %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= link_to new_dish_path, class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:plus) %><%= t("dishes.index.new_dish") %>
    <% end %>
  <% end %>
<% end %>

<div class="content">
  <div class="toolbar">
    <div class="toolbar-filters">
      <span class="muted"><%= t("filters.include") %>:</span>
      <% @dish_types.each do |dish_type| %>
        <%= toggle_param_link(t("dishes.types.#{dish_type}"),
              mode: :include,
              target: dish_type,
              include_param: "dish_types",
              exclude_param: "exclude_dish_types",
              request: request,
              css: "chip-include") %>
      <% end %>
      <% @restrictions.each do |restriction| %>
        <%= toggle_param_link(restriction.name,
              mode: :include,
              target: restriction.id,
              include_param: "include_restrictions",
              exclude_param: "exclude_restrictions",
              request: request,
              css: "chip-include") %>
      <% end %>
      <span class="toolbar-sep"></span>
      <span class="muted"><%= t("filters.exclude") %>:</span>
      <% @restrictions.each do |restriction| %>
        <%= toggle_param_link(restriction.name,
              mode: :exclude,
              target: restriction.id,
              include_param: "include_restrictions",
              exclude_param: "exclude_restrictions",
              request: request,
              css: "chip-exclude") %>
      <% end %>
      <% if params[:dish_types].present? || params[:include_restrictions].present? || params[:exclude_restrictions].present? %>
        <%= link_to t("filters.clear"),
              dishes_path(request.query_parameters.except(:dish_types, :include_restrictions, :exclude_restrictions)),
              class: "chip-clear" %>
      <% end %>
    </div>
    <%= view_toggle(view, request, default_view: "grid") %>
  </div>

  <% if @dishes.any? %>
    <% if view == "grid" %>
      <%# Card grid — design uses pseudo dish images. We don't have an `image_url`
          column on Dish yet, so we render a textured placeholder. %>
      <div class="grid grid-3">
        <% @dishes.each do |dish| %>
          <%= link_to dish_path(dish), class: "dish" do %>
            <div class="dish-img">
              <span><%= dish.name.first(2).upcase %></span>
              <%# DESIGN-GAP: design shows compatibility status badge (ok / warn / block).
                  That depends on a SuggestionService that filters by selected restrictions.
                  Not implemented yet — badge omitted. %>
            </div>
            <div class="dish-body">
              <h3 class="dish-title"><%= dish.name %></h3>
              <p class="dish-desc"><%= truncate(dish.description, length: 90) %></p>
              <div class="dish-meta">
                <span class="tag"><%= t("dishes.types.#{dish.dish_type}") %></span>
                <%# DESIGN-GAP: `price` column not on Dish yet. Field would belong here. %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card">
        <% @dishes.each do |dish| %>
          <%= link_to dish_path(dish), class: "card-row is-link" do %>
            <div class="dish-mini-thumb"><%= dish.name.first(2).upcase %></div>
            <div class="grow">
              <div class="strong"><%= dish.name %></div>
              <div class="muted mt-1"><%= truncate(dish.description, length: 90) %></div>
            </div>
            <span class="tag"><%= t("dishes.types.#{dish.dish_type}") %></span>
            <span class="muted"><%= serf_icon(:chevron) %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state"><%= t("dishes.index.no_dishes") %></div>
  <% end %>
</div>
