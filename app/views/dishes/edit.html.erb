<% content_for :title, t("dishes.edit.title") %>

<%= render "shared/topbar", title: t("dishes.edit.title"),
    subtitle: breadcrumb([t("dishes.index.title"), dishes_path],
                          [@dish.name, dish_path(@dish)],
                          [t("dishes.edit.title"), nil]) %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", dish: @dish %>
    </div>
  </div>
</div>
