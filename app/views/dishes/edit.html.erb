<% content_for :title, t("dishes.edit.title") %>

<%= render "shared/topbar", title: t("dishes.edit.title"), subtitle: @dish.name do %>
  <%= link_to dish_path(@dish), class: "btn btn-ghost btn-sm" do %>
    <%= serf_icon(:chevron_left) %><%= t("dishes.show.back") %>
  <% end %>
<% end %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", dish: @dish %>
    </div>
  </div>
</div>
