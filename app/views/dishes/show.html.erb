<% content_for :title, @dish.name %>

<%= render "shared/topbar", title: @dish.name,
    subtitle: breadcrumb([t("dishes.index.title"), dishes_path], [@dish.name, nil]) do %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= button_to dish_path(@dish), method: :delete,
                  class: "btn btn-secondary btn-sm",
                  form: { data: { turbo_confirm: t("dishes.show.confirm_delete") } } do %>
      <%= serf_icon(:trash) %><%= t("dishes.show.delete") %>
    <% end %>
    <%= link_to edit_dish_path(@dish), class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:edit) %><%= t("dishes.show.edit") %>
    <% end %>
  <% end %>
<% end %>

<div class="content col">
  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("dishes.show.description") %></h3></div>
    <div class="card-body">
      <% if @dish.description.present? %>
        <%= simple_format(@dish.description) %>
      <% else %>
        <span class="muted"><%= t("dishes.show.no_description") %></span>
      <% end %>

      <%= render "shared/restriction_tags",
                 restrictions: (@dish.ingredients + @dish.elaborations.flat_map(&:ingredients)).flat_map(&:restrictions).uniq,
                 wrapper_class: "wrap gap-1 mt-3" %>
    </div>
  </div>

  <div class="card">
    <div class="card-header">
      <h3 class="card-title"><%= t("dishes.show.ingredients") %></h3>
      <span class="muted"><%= @dish.ingredients.size %></span>
    </div>
    <% if @dish.ingredients.any? %>
      <% essential_dis = @dish.dish_ingredients.select(&:essential?) %>
      <% substituible_dis = @dish.dish_ingredients.reject(&:essential?) %>
      <% first_section = true %>

      <% if essential_dis.any? %>
        <div class="ingredient-section-header ingredient-section-first">
          <span class="ingredient-section-dot" style="background: var(--brand-red)"></span>
          <span class="ingredient-section-title"><%= t("dishes.show.essential_header") %></span>
          <span class="ingredient-section-subtitle"><%= t("dishes.show.essential_subtitle") %></span>
        </div>
        <% essential_dis.each do |di| %>
          <%= link_to ingredient_path(di.ingredient), class: "ingredient-row is-link" do %>
            <span class="ingredient-bar ingredient-bar-essential"></span>
            <div class="grow">
              <div class="strong"><%= di.ingredient.name %></div>
              <% if di.ingredient.restrictions.any? %>
                <div class="row mt-2">
                  <% di.ingredient.restrictions.each do |restriction| %>
                    <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
            <span class="muted"><%= serf_icon(:chevron) %></span>
          <% end %>
        <% end %>
        <% first_section = false %>
      <% end %>

      <% if substituible_dis.any? %>
        <div class="ingredient-section-header <%= first_section ? "ingredient-section-first" : "" %>">
          <span class="ingredient-section-dot" style="background: var(--accent-green)"></span>
          <span class="ingredient-section-title"><%= t("dishes.show.substituible_header") %></span>
          <span class="ingredient-section-subtitle"><%= t("dishes.show.substituible_subtitle") %></span>
        </div>
        <% substituible_dis.each do |di| %>
          <%= link_to ingredient_path(di.ingredient), class: "ingredient-row is-link" do %>
            <span class="ingredient-bar ingredient-bar-substituible"></span>
            <div class="grow">
              <div class="strong"><%= di.ingredient.name %></div>
              <% if di.ingredient.restrictions.any? %>
                <div class="row mt-2">
                  <% di.ingredient.restrictions.each do |restriction| %>
                    <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
                  <% end %>
                </div>
              <% end %>
            </div>
            <span class="muted"><%= serf_icon(:chevron) %></span>
          <% end %>
        <% end %>
      <% end %>
    <% else %>
      <div class="card-body muted"><%= t("dishes.show.no_ingredients") %></div>
    <% end %>
  </div>

  <% if @dish.elaborations.any? %>
    <div class="card">
      <div class="card-header"><h3 class="card-title"><%= t("dishes.show.elaborations") %></h3></div>
      <% @dish.elaborations.each do |elaboration| %>
        <%= link_to elaboration_path(elaboration), class: "card-row is-link" do %>
          <span class="avatar avatar-sm" style="--avatar-bg: var(--accent-green);">
            <%= serf_icon(:leaf) %>
          </span>
          <div class="grow">
            <div class="strong"><%= elaboration.name %></div>
            <% restrictions = elaboration.restrictions %>
            <% if restrictions.any? %>
              <div class="row mt-2">
                <% restrictions.each do |restriction| %>
                  <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
                <% end %>
              </div>
            <% end %>
          </div>
          <span class="muted"><%= serf_icon(:chevron) %></span>
        <% end %>
      <% end %>
    </div>
  <% end %>
</div>
