<%= form_with(model: dish, class: "form-container") do |form| %>
  <% if dish.errors.any? %>
    <div class="alert-error">
      <h3><%= t("errors.form_header", count: dish.errors.count) %></h3>
      <ul>
        <% dish.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= form.label :name, t("dishes.form.name") %>
    <%= form.text_field :name, class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :description, t("dishes.form.description") %>
    <%= form.text_area :description, class: "form-control", rows: 4 %>
  </div>

  <div class="form-group">
    <%= form.label :dish_type, t("dishes.form.dish_type") %>
    <%= form.select :dish_type,
      Dish.dish_types.keys.map { |k| [t("dishes.types.#{k}"), k] },
      {},
      class: "form-control" %>
  </div>

  <div class="form-group">
    <%= form.label :ingredient_ids, t("dishes.form.ingredients") %>
    <div class="checkbox-group">
      <% @ingredients.each do |ingredient| %>
        <div class="checkbox-item">
          <%= form.check_box :ingredient_ids, { multiple: true, include_hidden: false }, ingredient.id, nil %>
          <%= form.label "dish_ingredient_ids_#{ingredient.id}", ingredient.name %>
        </div>
      <% end %>
    </div>
  </div>

  <div class="form-actions">
    <%= form.submit dish.new_record? ? t("dishes.form.submit_create") : t("dishes.form.submit_update"), class: "btn-primary" %>
    <%= link_to t("dishes.form.cancel"), dishes_path, class: "btn-secondary" %>
  </div>
<% end %>
