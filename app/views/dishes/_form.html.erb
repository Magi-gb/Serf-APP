<%= form_with(model: dish) do |form| %>
  <%= render "shared/form_errors", object: dish %>

  <div class="field">
    <%= form.label :name, t("dishes.form.name"), class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <div class="field">
    <%= form.label :description, t("dishes.form.description"), class: "label" %>
    <%= form.text_area :description, class: "textarea", rows: 4 %>
  </div>

  <div class="field">
    <%= form.label :dish_type, t("dishes.form.dish_type"), class: "label" %>
    <%= form.select :dish_type,
                    Dish.dish_types.keys.map { |k| [t("dishes.types.#{k}"), k] },
                    {}, class: "select" %>
  </div>

  <%# DESIGN-GAP: design lets the form mark each ingredient as "imprescindible / substituïble".
      That maps to a future `essential` boolean on DishIngredient (already in the planned model
      per CLAUDE.md). Until added, the form only attaches ingredients without that classification. %>
  <fieldset class="field">
    <legend class="label"><%= t("dishes.form.ingredients") %></legend>
    <div class="checkbox-cards">
      <% @ingredients.each do |ingredient| %>
        <label class="checkbox-card">
          <%= form.check_box :ingredient_ids, { multiple: true, include_hidden: false }, ingredient.id, nil %>
          <span><%= ingredient.name %></span>
          <% if ingredient.restrictions.any? %>
            <span class="row">
              <% ingredient.restrictions.first(3).each do |restriction| %>
                <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
              <% end %>
            </span>
          <% end %>
        </label>
      <% end %>
    </div>
  </fieldset>

  <div class="row mt-4">
    <%= form.submit dish.new_record? ? t("dishes.form.submit_create") : t("dishes.form.submit_update"),
                    class: "btn btn-primary" %>
    <%= link_to t("dishes.form.cancel"), dishes_path, class: "btn btn-secondary" %>
  </div>
<% end %>
