<% content_for :title, t("protocols.index.title") %>
<% view = params[:view].presence || "list" %>

<%= render "shared/topbar", title: t("protocols.index.title") do %>
  <%= form_with url: protocols_path, method: :get, local: true, class: "search" do |f| %>
    <span class="search-icon"><%= serf_icon(:search) %></span>
    <%= f.search_field :search, value: params[:search], placeholder: t("protocols.index.search_placeholder"), class: "input" %>
  <% end %>
  <% if current_user.admin? %>
    <%= link_to new_protocol_path, class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:plus) %><%= t("protocols.index.create") %>
    <% end %>
  <% end %>
<% end %>

<div class="content">
  <div class="toolbar">
    <div></div>
    <%= view_toggle(view, request, default_view: "list") %>
  </div>

  <% if @protocols.any? %>
    <% if view == "grid" %>
      <div class="grid grid-3">
        <% @protocols.each do |protocol| %>
          <%= link_to protocol_path(protocol), class: "card ingredient-grid-card" do %>
            <div class="row">
              <span class="avatar avatar-sm">
                <%= serf_icon(:alert) %>
              </span>
              <div class="grow">
                <div class="strong"><%= protocol.name %></div>
                <% if protocol.description.present? %>
                  <p class="muted mt-1 mb-0 truncate-2"><%= protocol.description %></p>
                <% end %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card">
        <% @protocols.each do |protocol| %>
          <%= link_to protocol_path(protocol), class: "card-row is-link" do %>
            <span class="avatar avatar-sm">
              <%= serf_icon(:alert) %>
            </span>
            <div class="grow">
              <div class="strong"><%= protocol.name %></div>
              <% if protocol.description.present? %>
                <div class="muted mt-2"><%= truncate(protocol.description, length: 120) %></div>
              <% end %>
            </div>
            <span class="muted"><%= serf_icon(:chevron) %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state"><%= t("protocols.index.empty") %></div>
  <% end %>
</div>
