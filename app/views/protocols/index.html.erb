<% content_for :title, t(".title") %>

<div class="page-card">
  <div class="page-header">
    <h1 class="serf-page-title"><%= t(".title") %></h1>
  </div>

  <div class="index-toolbar">
    <%= render "shared/search_bar", url: protocols_path, placeholder: t(".search_placeholder") %>
    <% if current_user.admin? %>
      <%= link_to t(".create"), new_protocol_path, class: "btn-pill btn-pill-primary" %>
    <% end %>
  </div>

  <div class="list-card-group">
    <% if @protocols.any? %>
      <% @protocols.each do |protocol| %>
        <%= link_to protocol_path(protocol), class: "list-card" do %>
          <div class="list-card-info">
            <span class="list-card-title"><%= protocol.name %></span>
            <span class="list-card-subtitle"><%= protocol.description.truncate(100) if protocol.description.present? %></span>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="empty-state"><%= t(".empty") %></p>
    <% end %>
  </div>
</div>
