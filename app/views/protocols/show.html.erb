<% content_for :title, @protocol.name %>

<div class="page-card">
  <div class="detail-section">
    <div class="detail-header">
      <div class="detail-avatar" style="background-color: <%= @protocol.bg_color.presence || 'var(--color-bg-blue)' %>;">
        <% if @protocol.icon_svg.present? %>
          <%= safe_svg(@protocol.icon_svg) %>
        <% else %>
          <%= @protocol.name[0..1].upcase %>
        <% end %>
      </div>
      <h2 class="serf-page-title"><%= @protocol.name %></h2>
    </div>

    <div class="desc-box" style="width: 100%; max-width: 600px;">
      <div class="field-group">
        <span class="field-label"><%= Protocol.human_attribute_name(:description) %></span>
        <p class="desc-text"><%= @protocol.description.presence || t(".no_description") %></p>
      </div>
    </div>

    <div class="detail-actions">
      <%= link_to t(".back"), protocols_path, class: "btn-secondary" %>
      <% if current_user.admin? %>
        <%= link_to t(".edit"), edit_protocol_path(@protocol), class: "btn-primary" %>
        <%= button_to t(".delete"), @protocol, method: :delete, class: "btn-danger", form: { data: { turbo_confirm: t(".confirm_delete") } } %>
      <% end %>
    </div>
  </div>
</div>
