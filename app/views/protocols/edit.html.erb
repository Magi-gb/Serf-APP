<% content_for :title, t("protocols.edit.title") %>

<%= render "shared/topbar", title: t("protocols.edit.title"), subtitle: @protocol.name do %>
  <%= link_to protocol_path(@protocol), class: "btn btn-ghost btn-sm" do %>
    <%= serf_icon(:chevron_left) %><%= t("protocols.show.back") %>
  <% end %>
<% end %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", protocol: @protocol %>
    </div>
  </div>
</div>
