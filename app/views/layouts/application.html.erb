<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || t("app_name") %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="manifest" href="/manifest.json">
    <link rel="icon" href="<%= image_path('logos/IconoRojo.svg') %>" type="image/svg+xml">
    <link rel="apple-touch-icon" href="<%= image_path('logos/IconoRojo.svg') %>">
    <%= stylesheet_link_tag "application", "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body class="layout-with-sidebar">
    <%= render "layouts/sidebar" %>

    <main class="page-content-with-sidebar">
      <% if notice.present? %>
        <div class="alert-success"><%= notice %></div>
      <% end %>
      <% if alert.present? %>
        <div class="alert-error"><%= alert %></div>
      <% end %>

      <%= yield %>
    </main>
  </body>
</html>
