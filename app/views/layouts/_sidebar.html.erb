<%# SerF refined sidebar. Active state via aria-current="page". %>
<aside class="sidebar">
  <div class="sidebar-head">
    <%= link_to root_path, class: "sidebar-brand", aria: { label: "Serf" } do %>
      <span class="sidebar-brand-mark">
        <svg viewBox="0 0 24 24" width="16" height="16" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M2 18h20" />
          <path d="M4 18a8 8 0 0 1 16 0" />
          <path d="M12 6v4" />
          <circle cx="12" cy="5" r="1.2" fill="currentColor" />
        </svg>
      </span>
      <span class="sidebar-brand-name">SerF</span>
    <% end %>
    <button type="button"
            class="sidebar-close"
            data-controller="sidebar"
            data-action="click->sidebar#close"
            aria-label="<%= t("sidebar.close") %>">
      <%= serf_icon(:x) %>
    </button>
  </div>

  <nav class="sidebar-nav">
    <%= link_to root_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "home") } do %>
      <%= serf_icon(:home) %><span><%= t("sidebar.dashboard") %></span>
    <% end %>

    <%= link_to menus_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "menus") } do %>
      <%= serf_icon(:book) %><span><%= t("sidebar.menus") %></span>
    <% end %>

    <%= link_to dishes_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "dishes") } do %>
      <%= serf_icon(:forkknife) %><span><%= t("sidebar.dishes") %></span>
    <% end %>

    <%= link_to ingredients_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "ingredients") } do %>
      <%= serf_icon(:leaf) %><span><%= t("sidebar.ingredients") %></span>
    <% end %>

    <%= link_to restrictions_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "restrictions") } do %>
      <%= serf_icon(:shield) %><span><%= t("sidebar.restrictions") %></span>
    <% end %>

    <%= link_to preparations_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "preparations") } do %>
      <%= serf_icon(:forkknife) %><span><%= t("sidebar.preparations") %></span>
    <% end %>

    <%= link_to protocols_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "protocols") } do %>
      <%= serf_icon(:alert) %><span><%= t("sidebar.protocols") %></span>
    <% end %>

    <% if current_user&.admin? %>
      <%= link_to users_path, class: "sidebar-link", aria: { current: ("page" if controller_name == "users") } do %>
        <%= serf_icon(:users) %><span><%= t("sidebar.personal") %></span>
      <% end %>
    <% end %>
  </nav>

  <div class="sidebar-spacer"></div>

  <div class="sidebar-footer">
    <%# DESIGN-GAP: design proposes "Emergències · 112" linking to an emergency protocol. %>
    <%# We don't track an "emergency" flag on Protocol; currently a plain tel: link. %>
    <a href="tel:112" class="sidebar-emergency">
      <%= serf_icon(:phone) %><span><%= t("sidebar.emergencies") %> · 112</span>
    </a>

    <% if current_user %>
      <div class="sidebar-user">
        <%= link_to profile_path, class: "sidebar-user-link" do %>
          <span class="avatar avatar-sm"
                style="--avatar-bg: oklch(0.6 0.12 <%= (current_user.username.sum % 360) %>);">
            <%= current_user.username.first(2).upcase %>
          </span>
          <div class="grow">
            <div class="sidebar-user-name"><%= current_user.username %></div>
            <div class="sidebar-user-role"><%= t("users.roles.#{current_user.role}") %></div>
          </div>
        <% end %>
        <%= button_to destroy_user_session_path,
                      method: :delete,
                      form: { class: "sidebar-logout-form" },
                      class: "sidebar-logout",
                      title: t("sidebar.logout") do %>
          <%= serf_icon(:logout) %>
        <% end %>
      </div>
    <% end %>
  </div>
</aside>
