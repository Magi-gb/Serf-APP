<ul class="sidenav">
  <li class="sidenav-logo">
    <%= image_tag "logos/LogoHorBl.svg", alt: "Serf" %>
  </li>

  <% if current_user.admin? %>
    <li class="<%= "sidenav-active" if controller_name == "users" %>">
      <%= link_to t("sidebar.personal", default: "Personal"), users_path %>
    </li>
  <% end %>

  <li class="<%= "sidenav-active" if controller_name == "restrictions" %>">
    <%= link_to t("sidebar.restrictions", default: "Filtrar restriccions"), restrictions_path %>
  </li>

  <li class="<%= "sidenav-active" if controller_name == "profiles" %>">
    <%= link_to t("sidebar.profile", default: "El meu perfil"), profile_path %>
  </li>

  <li class="sidenav-footer">
    <%= link_to t("sidebar.emergencies", default: "Emergències"), "#", class: "btn-emergencies" %>
  </li>

  <li class="sidenav-logout">
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete } do %>
      <%= image_tag "icons/log-out-white.svg", class: "sidenav-logout-icon" %>
      <%= t("sidebar.logout", default: "Tancar sessió") %>
    <% end %>
  </li>
</ul>
