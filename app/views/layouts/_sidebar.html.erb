<nav class="sidebar">
  <div class="sidebar__brand">
    <%= image_tag "logos/Recurso 3.svg", alt: "Serf", class: "sidebar__logo" %>
  </div>

  <ul class="sidebar__menu">
    <% if current_user.kitchen_manager? || current_user.admin? %>
      <li class="sidebar__item <%= 'sidebar__item--active' if controller_name == 'ingredients' && action_name == 'index' %>">
        <%= link_to t("sidebar.ingredients"), ingredients_path, class: "sidebar__link" %>
      </li>

      <li class="sidebar__item <%= 'sidebar__item--active' if controller_name == 'ingredients' && action_name == 'new' %>">
        <%= link_to t("sidebar.add_ingredient"), new_ingredient_path, class: "sidebar__link" %>
      </li>

      <li class="sidebar__item <%= 'sidebar__item--active' if controller_name == 'ingredients' && action_name == 'delete' %>">
       <%= link_to t("sidebar.remove_ingredient"), ingredients_delete_path, class: "sidebar__link" %>
      </li>
    <% end %>

    <% if current_user.admin? %>
      <li class="sidebar__item <%= "sidebar__item--active" if controller_name == "users" %>">
        <%= link_to t("sidebar.personal"), users_path, class: "sidebar__link" %>
      </li>
    <% end %>

    <li class="sidebar__item <%= "sidebar__item--active" if controller_name == "profiles" %>">
      <%= link_to t("sidebar.profile"), profile_path, class: "sidebar__link" %>
    </li>
  </ul>

  <div class="sidebar__footer">
    <%= link_to t("sidebar.logout"), destroy_user_session_path, data: { turbo_method: :delete }, class: "sidebar__link sidebar__link--logout" %>
  </div>
</nav>
