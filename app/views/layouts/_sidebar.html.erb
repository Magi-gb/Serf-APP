<ul class="sidenav">
  <li class="sidenav-logo">
    <%= image_tag "logos/LogoHorBl.svg", alt: "Serf" %>
  </li>

  <li class="<%= "sidenav-active" if controller_name == "home" %>">
    <%= link_to t("sidebar.dashboard"), root_path %>
  </li>

  <li class="<%= "sidenav-active" if controller_name == "ingredients" %>">
    <%= link_to t("sidebar.ingredients"), ingredients_path %>
  </li>

  <li class="<%= "sidenav-active" if controller_name == "plats" %>">
    <%= link_to t("sidebar.plats"), plats_path %>
  </li>


  <li class="<%= "sidenav-active" if controller_name == "menus" %>">
    <%= link_to t("sidebar.menus"), menus_path %>
  </li>

  <li class="<%= "sidenav-active" if controller_name == "restrictions" %>">
    <%= link_to t("sidebar.restrictions"), restrictions_path %>
  </li>

  <li class="<%= "sidenav-active" if controller_name == "protocols" %>">
    <%= link_to t("sidebar.protocols"), protocols_path %>
  </li>

  <% if current_user.admin? %>
    <li class="<%= "sidenav-active" if controller_name == "users" %>">
      <%= link_to t("sidebar.personal"), users_path %>
    </li>
  <% end %>

  <li class="<%= "sidenav-active" if controller_name == "profiles" %>">
    <%= link_to t("sidebar.profile"), profile_path %>
  </li>

  <li class="sidenav-footer">
    <%= link_to t("sidebar.emergencies"), "#", class: "btn-emergencies" %>
  </li>

  <li class="sidenav-logout">
    <%= link_to destroy_user_session_path, data: { turbo_method: :delete } do %>
      <%= image_tag "icons/log-out-white.svg", class: "sidenav-logout-icon" %>
      <%= t("sidebar.logout") %>
    <% end %>
  </li>
</ul>
