    </li>

    <li class="sidebar__item">
      <%= link_to "Alternatives freqüents", "#", class: "sidebar__link" %>
    </li>

    <li class="sidebar__item">
      <%= link_to "Protocols", "#", class: "sidebar__link" %>
    </li>
    
    <li class="sidebar__item">
      <%= link_to "Glossari", "#", class: "sidebar__link" %>
    </li>

    <li class="sidebar__item <%= "sidebar__item--active" if controller_name == "profiles" %>">
      <%= link_to "El meu perfil", profile_path, class: "sidebar__link" %>
    </li>
  </ul>

  <div class="sidebar__footer" style="padding: 1.5rem; text-align: center; border-top: none;">
    <%= link_to "Emergències", "#", class: "btn-emergencies" %>
    <br><br>
    <%= button_to "Tancar sessió", destroy_user_session_path, method: :delete, class: "sidebar__link sidebar__link--logout", style: "background: none; border: none; padding: 0; cursor: pointer; text-decoration: underline; margin: 0 auto;" %>
