<nav class="sidebar">
  <div class="sidebar__brand">
    <%= image_tag "logos/Recurso 1.svg", alt: "Serf", class: "sidebar__logo sidebar__logo--shadowed" %>
  </div>

  <% if current_user.admin? || current_user.kitchen_manager? %>
    <div class="sidebar__action-box">
      <%= link_to t("sidebar.new_restriction"), new_restriction_path, class: "btn-nova-restriccio" %>
    </div>
  <% end %>

  <ul class="sidebar__menu">
    <% if current_user.admin? %>
      <li class="sidebar__item <%= "sidebar__item--active" if controller_name == "users" %>">
        <%= link_to t("sidebar.personal", default: "Personal"), users_path, class: "sidebar__link" %>
      </li>
    <% end %>

    <li class="sidebar__item">
      <%= link_to t("sidebar.menu", default: "Menú"), "#", class: "sidebar__link" %>
    </li>

    <li class="sidebar__item <%= "sidebar__item--active" if controller_name == "restrictions" %>">
      <%= link_to t("sidebar.restrictions", default: "Filtrar restriccions"), restrictions_path, class: "sidebar__link" %>
    </li>

    <li class="sidebar__item">
      <%= link_to t("sidebar.alternatives", default: "Alternatives freqüents"), "#", class: "sidebar__link" %>
    </li>

    <li class="sidebar__item">
      <%= link_to t("sidebar.protocols", default: "Protocols"), "#", class: "sidebar__link" %>
    </li>
    
    <li class="sidebar__item">
      <%= link_to t("sidebar.glossary", default: "Glossari"), "#", class: "sidebar__link" %>
    </li>

    <li class="sidebar__item <%= "sidebar__item--active" if controller_name == "profiles" %>">
      <%= link_to t("sidebar.profile", default: "El meu perfil"), profile_path, class: "sidebar__link" %>
    </li>
  </ul>

  <div class="sidebar__footer sidebar__footer--custom">
    <%= link_to t("sidebar.emergencies", default: "Emergències"), "#", class: "btn-emergencies" %>
    <br><br>
    <%= button_to t("sidebar.logout", default: "Tancar sessió"), destroy_user_session_path, method: :delete, class: "sidebar__link sidebar__link--logout sidebar__btn-logout" %>
  </div>
</nav>
