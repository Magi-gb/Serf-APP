<% content_for :title, t("users.edit.title") %>

<%= render "shared/topbar", title: t("users.edit.title"), subtitle: @user.username do %>
  <%= link_to user_path(@user), class: "btn btn-ghost btn-sm" do %>
    <%= serf_icon(:chevron_left) %><%= t("users.show.back") %>
  <% end %>
<% end %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", user: @user %>
    </div>
  </div>
</div>
