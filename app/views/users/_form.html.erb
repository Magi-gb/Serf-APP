<%= form_with(model: user) do |f| %>
  <%= render "shared/form_errors", object: user %>

  <div class="field">
    <%= f.label :username, t("users.form.username"), class: "label required" %>
    <%= f.text_field :username, class: "input" %>
  </div>

  <div class="field">
    <%= f.label :role, t("users.form.role"), class: "label required" %>
    <%= f.select :role,
                  User.roles.keys.map { |r| [t("users.roles.#{r}"), r] },
                  {}, class: "select" %>
    <%# DESIGN-GAP: design shows roles as explanatory cards with permissions tags
        (Administradora / Cap de cuina / Personal de cuina / Cambrera) — 4 roles vs.
        our 3 enum values. Adding a "kitchen staff" role would need an enum change. %>
  </div>

  <div class="field">
    <%= f.label :password, t("users.form.password"), class: "label required" %>
    <%= f.password_field :password, class: "input" %>
    <% if user.persisted? %>
      <div class="field-hint"><%= t("users.form.password_hint_edit") %></div>
    <% end %>
  </div>

  <div class="field">
    <%= f.label :password_confirmation, t("users.form.password_confirmation"), class: "label" %>
    <%= f.password_field :password_confirmation, class: "input" %>
  </div>

  <%# DESIGN-GAP: design also has email, restaurant, avatar color picker, active toggle,
      internal notes and a "Danger zone" with deactivate. None of those fields exist on User. %>

  <div class="row mt-4">
    <%= f.submit user.persisted? ? t("users.form.submit_update") : t("users.form.submit_create"),
                  class: "btn btn-primary" %>
    <%= link_to t("users.form.cancel"), users_path, class: "btn btn-secondary" %>
  </div>
<% end %>
