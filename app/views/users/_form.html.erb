<%= form_with(model: user, class: "user-form") do |f| %>
  <% if user.errors.any? %>
    <div class="form-errors">
      <ul>
        <% user.errors.full_messages.each do |message| %>
          <li><%= message %></li>
        <% end %>
      </ul>
    </div>
  <% end %>

  <div class="form-group">
    <%= f.label :username, t("users.form.username"), class: "form-label" %>
    <%= f.text_field :username, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :role, t("users.form.role"), class: "form-label" %>
    <%= f.select :role, User.roles.keys.map { |r| [t("users.roles.#{r}"), r] }, {}, class: "form-input" %>
  </div>

  <div class="form-group">
    <%= f.label :password, t("users.form.password"), class: "form-label" %>
    <%= f.password_field :password, class: "form-input" %>
    <% if user.persisted? %>
      <span class="form-hint"><%= t("users.form.password_hint_edit") %></span>
    <% end %>
  </div>

  <div class="form-group">
    <%= f.label :password_confirmation, t("users.form.password_confirmation"), class: "form-label" %>
    <%= f.password_field :password_confirmation, class: "form-input" %>
  </div>

  <div class="form-actions">
    <%= f.submit user.persisted? ? t("users.form.submit_update") : t("users.form.submit_create"), class: "btn btn--primary" %>
  </div>
<% end %>
