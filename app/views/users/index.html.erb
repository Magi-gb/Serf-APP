<div class="users-header">
  <h1><%= t("users.index.title") %></h1>
</div>

<div class="users-search">
  <%= form_tag users_path, method: :get, class: "search-form" do %>
    <%= text_field_tag :search, params[:search], placeholder: t("users.index.search_placeholder"), class: "search-form__input" %>
  <% end %>
</div>

<div class="users-list">
  <% if @users.any? %>
    <% @users.each do |user| %>
      <%= link_to user_path(user), class: "user-card" do %>
        <div class="user-card__avatar" style="background-color: <%= user_avatar_color(user) %>;">
          <%= user.username[0].upcase %>
        </div>
        <div class="user-card__info">
          <span class="user-card__username"><%= user.username %></span>
          <span class="user-card__role"><%= t("users.roles.#{user.role}") %></span>
        </div>
      <% end %>
    <% end %>
  <% else %>
    <p class="users-empty"><%= t("users.index.no_users") %></p>
  <% end %>
</div>

<div class="users-actions">
  <%= link_to t("users.index.new_user"), new_user_path, class: "btn btn--primary" %>
</div>
