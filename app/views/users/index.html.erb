<div class="page-card">
  <div class="page-header">
    <h1><%= t("users.index.title") %></h1>
  </div>

  <div class="mb-3">
    <div class="search-bar">
      <%= form_tag users_path, method: :get, class: "search-form" do %>
        <%= text_field_tag :search, params[:search], placeholder: t("users.index.search_placeholder") %>
        <span class="search-bar-icon">&#128269;</span>
      <% end %>
    </div>
  </div>

  <div class="list-card-group">
    <% if @users.any? %>
      <% @users.each do |user| %>
        <%= link_to user_path(user), class: "list-card" do %>
          <div class="list-card-avatar" style="background-color: <%= user_avatar_color(user) %>;">
            <%= user.username[0].upcase %>
          </div>
          <div class="list-card-info">
            <span class="list-card-title"><%= user.username %></span>
            <span class="list-card-subtitle"><%= t("users.roles.#{user.role}") %></span>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="empty-state"><%= t("users.index.no_users") %></p>
    <% end %>
  </div>

  <div class="mt-2">
    <%= link_to t("users.index.new_user"), new_user_path, class: "btn-primary" %>
  </div>
</div>
