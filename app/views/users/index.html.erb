<div class="page-card">
  <div class="page-header">
    <h1><%= t("users.index.title") %></h1>
  </div>

  <div class="index-toolbar">
    <%= render "shared/search_bar", url: users_path, placeholder: t("users.index.search_placeholder") %>
    <%= link_to new_user_path, class: "btn-pill btn-pill-primary" do %>
      <%= image_tag "icons/user-plus-white.svg", size: "18x18" %>
      <%= t("users.index.new_user") %>
    <% end %>
  </div>

  <div class="list-card-group">
    <% if @users.any? %>
      <% @users.each do |user| %>
        <%= link_to user_path(user), class: "list-card" do %>
          <div class="list-card-avatar" style="--avatar-bg: <%= user_avatar_color(user) %>;">
            <%= user.username[0].upcase %>
          </div>
          <div class="list-card-info">
            <span class="list-card-title"><%= user.username %></span>
            <span class="list-card-subtitle"><%= t("users.roles.#{user.role}") %></span>
          </div>
        <% end %>
      <% end %>
    <% else %>
      <p class="empty-state"><%= t("users.index.no_users") %></p>
    <% end %>
  </div>
</div>
