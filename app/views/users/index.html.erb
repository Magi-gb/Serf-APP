<% content_for :title, t("users.index.title") %>

<%# DESIGN-GAP: design includes a sticky detail panel on the right with extended user
    metadata (email, restaurant, permissions, last login, notes, "Created on"). User
    model only has username + role. Email, site, last_seen, notes don't exist. %>
<%= render "shared/topbar", title: t("users.index.title") do %>
  <%= form_with url: users_path, method: :get, local: true, class: "search" do |f| %>
    <span class="search-icon"><%= serf_icon(:search) %></span>
    <%= f.search_field :search, value: params[:search], placeholder: t("users.index.search_placeholder"), class: "input" %>
  <% end %>
  <%= link_to new_user_path, class: "btn btn-primary btn-sm" do %>
    <%= serf_icon(:plus) %><%= t("users.index.new_user") %>
  <% end %>
<% end %>

<div class="content">
  <% if @users.any? %>
    <div class="card">
      <% @users.each do |user| %>
        <%= link_to user_path(user), class: "card-row is-link" do %>
          <span class="avatar avatar-sm" style="--avatar-bg: <%= user_avatar_color(user) %>;">
            <%= user.username.first(2).upcase %>
          </span>
          <div class="grow">
            <div class="strong"><%= user.username %></div>
            <div class="muted mt-2"><%= t("users.roles.#{user.role}") %></div>
          </div>
          <span class="muted"><%= serf_icon(:chevron) %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state"><%= t("users.index.no_users") %></div>
  <% end %>
</div>
