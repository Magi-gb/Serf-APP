<% content_for :title, @user.username %>

<%= render "shared/topbar", title: @user.username,
    subtitle: breadcrumb([t("users.index.title"), users_path], [@user.username, nil]) do %>
  <%= button_to user_path(@user), method: :delete,
                class: "btn btn-secondary btn-sm",
                form: { data: { turbo_confirm: t("users.show.confirm_delete") } } do %>
    <%= serf_icon(:trash) %><%= t("users.show.delete") %>
  <% end %>
  <%= link_to edit_user_path(@user), class: "btn btn-primary btn-sm" do %>
    <%= serf_icon(:edit) %><%= t("users.show.edit") %>
  <% end %>
<% end %>

<div class="content col">
  <div class="card">
    <div class="card-body row">
      <span class="avatar avatar-lg" style="--avatar-bg: <%= user_avatar_color(@user) %>;">
        <%= @user.username.first(2).upcase %>
      </span>
      <div class="grow">
        <div class="strong"><%= @user.username %></div>
        <div class="muted mt-2"><%= t("users.roles.#{@user.role}") %></div>
      </div>
    </div>
  </div>

  <%# DESIGN-GAP: design shows email, restaurant, last login, notes and a "Permisos"
      tag-pill with restrictive notes. The User model only has username + role.
      Email, site, last_seen, notes don't exist. %>
  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("users.show.title") %></h3></div>
    <div class="card-body col">
      <div class="detail-field">
        <div class="detail-field-label"><%= t("users.form.username") %></div>
        <div class="detail-field-value"><%= @user.username %></div>
      </div>
      <div class="detail-field">
        <div class="detail-field-label"><%= t("users.form.role") %></div>
        <div class="detail-field-value">
          <span class="tag"><%= t("users.roles.#{@user.role}") %></span>
        </div>
      </div>
    </div>
  </div>
</div>
