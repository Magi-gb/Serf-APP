<div class="page-card">
  <div class="detail-section">
    <div class="detail-avatar" style="--avatar-bg: <%= user_avatar_color(@user) %>;">
      <%= @user.username[0].upcase %>
    </div>

    <h1><%= @user.username %></h1>
    <p class="list-card-subtitle"><%= t("users.roles.#{@user.role}") %></p>

    <div class="detail-actions">
      <%= link_to t("users.show.edit"), edit_user_path(@user), class: "btn-primary" %>
      <%= link_to t("users.show.delete"), user_path(@user), data: { turbo_method: :delete, turbo_confirm: t("users.show.confirm_delete") }, class: "btn-danger" %>
    </div>
  </div>
</div>
