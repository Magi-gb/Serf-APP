<div class="search-bar">
  <%= form_tag url, method: :get, class: "search-form" do %>
    <%= text_field_tag :search, params[:search], placeholder: placeholder %>
    <button type="submit" class="search-bar-icon"><%= image_tag "icons/search-white.svg", alt: t("users.index.search_alt"), size: "20x20" %></button>
  <% end %>
</div>
