<%= form_with(model: elaboration) do |form| %>
  <%= render "shared/form_errors", object: elaboration %>

  <div class="field">
    <%= form.label :name, t("elaborations.form.name"), class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <div class="field">
    <%= form.label :description, t("elaborations.form.description"), class: "label" %>
    <%= form.text_area :description, class: "textarea", rows: 4 %>
  </div>

  <div class="field">
    <label class="label"><%= t("elaborations.form.ingredients") %></label>
    <div class="picker card"
         data-controller="picker"
         data-picker-singular-value="<%= t("pickers.selected_one") %>"
         data-picker-plural-value="<%= t("pickers.selected_other", count: '%{count}') %>">
      <div class="card-body">
        <div class="picker-toolbar">
          <div class="picker-search search">
            <span class="search-icon"><%= serf_icon(:search) %></span>
            <input type="search"
                   class="input"
                   placeholder="<%= t("pickers.search_placeholder") %>"
                   data-picker-target="search"
                   data-action="input->picker#refresh keydown->picker#preventSubmit">
          </div>
          <span class="picker-count" data-picker-target="count"><%= t("pickers.selected_other", count: 0) %></span>
          <button type="button"
                  class="chip"
                  aria-pressed="false"
                  data-picker-target="onlySelected"
                  data-action="click->picker#toggleOnlySelected">
            <%= t("pickers.only_selected") %>
          </button>
        </div>

        <div class="checkbox-cards">
          <% ingredients.each do |ingredient| %>
            <% search_text = ([ ingredient.name ] + ingredient.restrictions.map(&:name)).join(" ") %>
            <label class="checkbox-card"
                   data-picker-target="item"
                   data-search-text="<%= search_text %>">
              <%= form.check_box :ingredient_ids,
                                  { multiple: true, include_hidden: false, data: { action: "change->picker#refresh" } },
                                  ingredient.id, nil %>
              <span><%= ingredient.name %></span>
              <% if ingredient.restrictions.any? %>
                <span class="row">
                  <% ingredient.restrictions.first(3).each do |restriction| %>
                    <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
                  <% end %>
                </span>
              <% end %>
            </label>
          <% end %>
        </div>

        <div class="picker-empty" data-picker-target="empty" hidden><%= t("pickers.none") %></div>
      </div>
    </div>
  </div>

  <div class="row mt-4">
    <%= form.submit elaboration.persisted? ? t("elaborations.form.submit_update") : t("elaborations.form.submit_create"),
                    class: "btn btn-primary" %>
    <%= link_to t("elaborations.form.cancel"), elaborations_path, class: "btn btn-secondary" %>
  </div>
<% end %>
