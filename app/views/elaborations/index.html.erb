<% content_for :title, t("elaborations.index.title") %>

<%= render "shared/topbar", title: t("elaborations.index.title") do %>
  <%= form_with url: elaborations_path, method: :get, local: true, class: "search" do |f| %>
    <span class="search-icon"><%= serf_icon(:search) %></span>
    <%= f.search_field :search, value: params[:search], placeholder: t("elaborations.index.search_placeholder"), class: "input" %>
  <% end %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= link_to new_elaboration_path, class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:plus) %><%= t("elaborations.index.new_elaboration") %>
    <% end %>
  <% end %>
<% end %>

<div class="content">
  <% if @elaborations.any? %>
    <div class="card">
      <% @elaborations.each do |elaboration| %>
        <%= link_to elaboration_path(elaboration), class: "card-row is-link" do %>
          <span class="avatar avatar-sm" style="--avatar-bg: <%= elaboration.restrictions.any?(&:intolerance_allergy?) ? 'var(--tag-allergen)' : 'var(--accent-green)' %>;">
            <%= serf_icon(:leaf) %>
          </span>
          <div class="grow">
            <div class="strong"><%= elaboration.name %></div>
            <% restrictions = elaboration.restrictions %>
            <% if restrictions.any? %>
              <div class="row mt-2">
                <% restrictions.each do |restriction| %>
                  <span class="tag tag-<%= restriction_tag_kind(restriction) %>"><%= restriction.name %></span>
                <% end %>
              </div>
            <% else %>
              <div class="muted mt-2"><%= t("elaborations.index.no_restrictions") %></div>
            <% end %>
          </div>
          <span class="muted"><%= serf_icon(:chevron) %></span>
        <% end %>
      <% end %>
    </div>
  <% else %>
    <div class="empty-state"><%= t("elaborations.index.no_elaborations") %></div>
  <% end %>
</div>
