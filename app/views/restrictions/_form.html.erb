<%= form_with(model: restriction) do |form| %>
  <%= render "shared/form_errors", object: restriction %>

  <div class="field">
    <%= form.label :name, t("restrictions.form.name"), class: "label required" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <div class="field">
    <%= form.label :description, t("restrictions.form.description"), class: "label" %>
    <%= form.text_area :description, class: "textarea", rows: 4 %>
  </div>

  <div class="field">
    <%= form.label :restriction_type, t("restrictions.form.restriction_type"), class: "label required" %>
    <%= form.select :restriction_type,
                    Restriction.restriction_types.keys.map { |k| [t("restrictions.types.#{k}"), k] },
                    {}, class: "select" %>
  </div>

  <div class="field">
    <%= form.label :severity, t("restrictions.form.severity"), class: "label" %>
    <div class="severity-chips">
      <% [[:low, "accent-green"], [:medium, "state-warning"], [:high, "brand-red"]].each do |sev, color| %>
        <label class="severity-chip severity-chip-<%= sev %>">
          <%= form.radio_button :severity, sev %>
          <span class="severity-chip-dot" style="background: var(--<%= color %>);"></span>
          <span><%= t("restrictions.severity.#{sev}") %></span>
        </label>
      <% end %>
    </div>
  </div>

  <div class="row mt-4">
    <%= form.submit t("restrictions.form.submit"), class: "btn btn-primary" %>
    <%= link_to t("restrictions.form.cancel"), restrictions_path, class: "btn btn-secondary" %>
  </div>
<% end %>
