<% content_for :title, t("restrictions.edit.title") %>

<%= render "shared/topbar", title: t("restrictions.edit.title"),
    subtitle: breadcrumb([t("restrictions.index.title"), restrictions_path],
                          [@restriction.name, restriction_path(@restriction)],
                          [t("restrictions.edit.title"), nil]) %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", restriction: @restriction %>
    </div>
  </div>
</div>
