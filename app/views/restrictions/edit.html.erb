<% content_for :title, t("restrictions.edit.title") %>

<%= render "shared/topbar", title: t("restrictions.edit.title"), subtitle: @restriction.name do %>
  <%= link_to restriction_path(@restriction), class: "btn btn-ghost btn-sm" do %>
    <%= serf_icon(:chevron_left) %><%= t("restrictions.show.back") %>
  <% end %>
<% end %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", restriction: @restriction %>
    </div>
  </div>
</div>
