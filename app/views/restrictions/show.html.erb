<% content_for :title, @restriction.name %>
<div class="restrictions-container">
  <div class="restrictions-header restrictions-show-header">
    <div class="restriction-icon restrictions-icon-nomargin" style="background-color: <%= @restriction.bg_color.presence || '#7bc143' %>">
      <% if @restriction.icon_svg.present? %>
        <%= raw @restriction.icon_svg %>
      <% else %>
        <span><%= @restriction.name[0..2].upcase %></span>
      <% end %>
    </div>
    <h1 class="restrictions-title-nomargin"><%= @restriction.name %></h1>
  </div>

  <div class="restrictions-desc-box">
    <h3 class="restrictions-desc-title"><%= t("restrictions.show.description_title") %></h3>
    <p class="restrictions-desc-text"><%= @restriction.description.presence || t("restrictions.show.no_description") %></p>
  </div>

  <div class="form-actions">
    <% if current_user.admin? || current_user.kitchen_manager? %>
      <%= link_to t("restrictions.show.edit"), edit_restriction_path(@restriction), class: "btn-primary btn-primary-link" %>
      <%= button_to t("restrictions.show.delete"), @restriction, method: :delete, class: "btn-danger", form: { data: { turbo_confirm: t("restrictions.show.confirm_delete") } } %>
    <% end %>
    <%= link_to t("restrictions.show.back"), restrictions_path, class: "btn-secondary" %>
  </div>
</div>
