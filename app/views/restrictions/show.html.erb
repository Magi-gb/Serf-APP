<% content_for :title, @restriction.name %>

<%= render "shared/topbar", title: @restriction.name, subtitle: t("restrictions.types.#{@restriction.restriction_type}") do %>
  <%= link_to restrictions_path, class: "btn btn-ghost btn-sm" do %>
    <%= serf_icon(:chevron_left) %><%= t("restrictions.show.back") %>
  <% end %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= link_to edit_restriction_path(@restriction), class: "btn btn-secondary btn-sm" do %>
      <%= serf_icon(:edit) %><%= t("restrictions.show.edit") %>
    <% end %>
    <%= button_to restriction_path(@restriction), method: :delete,
                  class: "btn btn-danger btn-sm",
                  form: { data: { turbo_confirm: t("restrictions.show.confirm_delete") } } do %>
      <%= serf_icon(:trash) %><%= t("restrictions.show.delete") %>
    <% end %>
  <% end %>
<% end %>

<div class="content col">
  <div class="card">
    <div class="card-body row">
      <span class="restr-bubble" style="--restr-bg: <%= @restriction.bg_color.presence || 'var(--accent-green-soft)' %>; --restr-fg: var(--text-on-brand);">
        <% if @restriction.icon_svg.present? %>
          <%= sanitize(@restriction.icon_svg, tags: %w[svg path circle rect g], attributes: %w[viewBox width height fill stroke stroke-width d cx cy r x y]) %>
        <% else %>
          <%= @restriction.name.first(4).upcase %>
        <% end %>
      </span>
      <div class="grow">
        <div class="strong"><%= @restriction.name %></div>
        <div class="tag tag-<%= restriction_tag_kind(@restriction) %> mt-2">
          <%= t("restrictions.types.#{@restriction.restriction_type}") %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("restrictions.show.description_title") %></h3></div>
    <div class="card-body"><%= @restriction.description.presence || content_tag(:span, t("restrictions.show.no_description"), class: "muted") %></div>
  </div>

  <%# DESIGN-GAP: design also shows "plats afectats" (with sub/no-sub status) and
      "ingredients que la contenen" panels. Ingredients ARE available via the
      association; "plats afectats" would require traversing ingredients→dishes
      and the `essential` flag for the no-sub status. Not implemented. %>
</div>
