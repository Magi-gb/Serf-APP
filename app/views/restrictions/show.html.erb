<% content_for :title, @restriction.name %>

<%= render "shared/topbar", title: @restriction.name,
    subtitle: breadcrumb([t("restrictions.index.title"), restrictions_path], [@restriction.name, nil]) do %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= button_to restriction_path(@restriction), method: :delete,
                  class: "btn btn-secondary btn-sm",
                  form: { data: { turbo_confirm: t("restrictions.show.confirm_delete") } } do %>
      <%= serf_icon(:trash) %><%= t("restrictions.show.delete") %>
    <% end %>
    <%= link_to edit_restriction_path(@restriction), class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:edit) %><%= t("restrictions.show.edit") %>
    <% end %>
  <% end %>
<% end %>

<div class="content col">
  <div class="card">
    <div class="card-body row">
      <span class="restr-bubble" style="--restr-bg: <%= @restriction.bg_color.presence || 'var(--accent-green-soft)' %>; --restr-fg: var(--text-on-brand);">
        <% if @restriction.icon_svg.present? %>
          <%= restriction_icon_svg(@restriction.icon_svg) %>
        <% else %>
          <%= @restriction.name.first(4).upcase %>
        <% end %>
      </span>
      <div class="grow">
        <div class="strong"><%= @restriction.name %></div>
        <div class="tag tag-<%= restriction_tag_kind(@restriction) %> mt-2">
          <%= t("restrictions.types.#{@restriction.restriction_type}") %>
        </div>
      </div>
    </div>
  </div>

  <div class="card">
    <div class="card-header"><h3 class="card-title"><%= t("restrictions.show.description_title") %></h3></div>
    <div class="card-body"><%= @restriction.description.presence || content_tag(:span, t("restrictions.show.no_description"), class: "muted") %></div>
  </div>

  <%# Ingredients that carry this restriction %>
  <div class="card">
    <div class="card-header">
      <h3 class="card-title">
        <%= t("restrictions.show.related_ingredients") %>
        <span class="muted"> · <%= @ingredients.size %></span>
      </h3>
    </div>
    <div class="card-body">
      <% if @ingredients.any? %>
        <div class="col">
          <% @ingredients.each do |ingredient| %>
            <%= link_to ingredient_path(ingredient), class: "restriction-card" do %>
              <span class="avatar" style="--avatar-bg: var(--accent-green);">
                <%= serf_icon(:leaf) %>
              </span>
              <div class="grow">
                <div class="strong"><%= ingredient.name %></div>
                <% if ingredient.description.present? %>
                  <div class="muted mt-1"><%= ingredient.description %></div>
                <% end %>
              </div>
              <span class="muted"><%= serf_icon(:chevron) %></span>
            <% end %>
          <% end %>
        </div>
      <% else %>
        <div class="muted text-center"><%= t("restrictions.show.no_ingredients") %></div>
      <% end %>
    </div>
  </div>
</div>
