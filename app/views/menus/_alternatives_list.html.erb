<% if alternatives.any? %>
  <div class="alternatives-radio-group">
    <% alternatives.each do |alternative| %>
      <label class="alternative-option">
        <input type="radio"
               name="alternative_for_dish_<%= dish.id %>"
               value="<%= alternative.id %>"
               class="alternative-radio" />
        <div class="alternative-card">
          <div class="alternative-card-img">
            <span><%= alternative.name.first(2).upcase %></span>
          </div>
          <div class="alternative-card-body">
            <h4 class="alternative-card-title"><%= alternative.name %></h4>
            <% restrictions = alternative.ingredients.flat_map(&:restrictions).uniq %>
            <% if restrictions.any? %>
              <div class="row mt-1">
                <% restrictions.each do |r| %>
                  <span class="tag tag-<%= restriction_tag_kind(r) %>"><span class="tag-dot"></span><%= r.name %></span>
                <% end %>
              </div>
            <% end %>
          </div>
        </div>
      </label>
    <% end %>
  </div>
<% else %>
  <div class="muted"><%= t("menus.show.no_alternatives") %></div>
<% end %>
