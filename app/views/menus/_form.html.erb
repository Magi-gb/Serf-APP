<%= form_with(model: menu) do |form| %>
  <%= render "shared/form_errors", object: menu %>

  <div class="field">
    <%= form.label :name, t("menus.form.name"), class: "label" %>
    <%= form.text_field :name, class: "input" %>
  </div>

  <%# DESIGN-GAP: design proposes a builder with sortable sections (Entrants/Primers/...),
      drag handles, per-section dish lookup, inline price editing and cobertura validation.
      We have a flat Menu→Dishes join with no sections, prices, validity dates or order.
      Showing a simple per-type checkbox group. %>
  <fieldset class="field">
    <legend class="label"><%= t("menus.form.dishes") %></legend>
    <% @dishes.group_by(&:dish_type).each do |type, dishes_in_type| %>
      <div class="muted strong mt-2"><%= t("dishes.types.#{type}") %></div>
      <div class="checkbox-cards mt-2">
        <% dishes_in_type.each do |dish| %>
          <label class="checkbox-card">
            <%= form.check_box :dish_ids, { multiple: true, include_hidden: false }, dish.id, nil %>
            <span><%= dish.name %></span>
          </label>
        <% end %>
      </div>
    <% end %>
  </fieldset>

  <div class="row mt-4">
    <%= form.submit menu.new_record? ? t("menus.form.submit_create") : t("menus.form.submit_update"),
                    class: "btn btn-primary" %>
    <%= link_to t("menus.form.cancel"), menus_path, class: "btn btn-secondary" %>
  </div>
<% end %>
