<% content_for :title, @menu.name %>

<div class="page-card">
  <div class="detail-section">
    <div class="detail-header">
        <h2 class="serf-page-title"><%= @menu.name %></h2>
    </div>

  <div class="desc-box desc-box-bounded">
    <h3><%= t("menus.show.dishes") %></h3>
    <% if @menu.dishes.any? %>
      <div class="badge-list">
        <% @menu.dishes.each do |dish| %>
          <%= link_to dish.name, dish_path(dish), class: "badge-big" %>
          <span class="badge"><%= t("dishes.types.#{dish.dish_type}") %></span>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state"><%= t("menus.show.no_dishes") %></p>
    <% end %>
  </div>

  <div class="detail-actions">
    <%= link_to t("menus.show.back"), menus_path, class: "btn-secondary" %>
    <% if current_user.admin? || current_user.kitchen_manager? %>
      <%= link_to t("menus.show.edit"), edit_menu_path(@menu), class: "btn-primary" %>
      <%= button_to t("menus.show.delete"), menu_path(@menu), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: t("menus.show.confirm_delete") } } %>
    <% end %>
  </div>
</div>
