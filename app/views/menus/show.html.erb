<div class="page-card">
  <div class="detail-header">
    <h1><%= @menu.name %></h1>
  </div>

  <div class="desc-box">
    <h3><%= t("menus.show.plats") %></h3>
    <% if @menu.plats.any? %>
      <div class="badge-list">
        <% @menu.plats.each do |plat| %>
          <%= link_to plat.name, plat_path(plat), class: "badge" %>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state"><%= t("menus.show.no_plats") %></p>
    <% end %>
  </div>

  <div class="detail-actions">
    <% if current_user.admin? || current_user.kitchen_manager? %>
      <%= link_to t("menus.show.edit"), edit_menu_path(@menu), class: "btn-primary" %>
      <%= button_to t("menus.show.delete"), menu_path(@menu), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: t("menus.show.confirm_delete") } } %>
    <% end %>
    <%= link_to t("menus.show.back"), menus_path, class: "btn-secondary" %>
  </div>
</div>