<% content_for :title, t("menus.show.title") %>

<div class="page-card">
  <div class="page-header">
    <h1 class="serf-page-title"><%= @menu.name %></h1>
  </div>

  <div class="menu-details">
    <h3><%= t("menus.show.plats", default: t('plats.index.title')) %></h3>
    <% if @menu.plats.any? %>
      <div class="list-card-group">
        <% @menu.plats.each do |plat| %>
          <div class="list-card">
            <div class="list-card-info">
              <span class="list-card-title"><%= plat.name %></span>
              <span class="list-card-subtitle"><%= t("plats.types.") %></span>
            </div>
          </div>
        <% end %>
      </div>
    <% else %>
      <p class="empty-state"><%= t("menus.show.no_plats", default: "Sense plats assignats") %></p>
    <% end %>
  </div>

  <div class="form-actions">
    <%= link_to t("menus.show.back"), menus_path, class: "btn-secondary" %>
    <%= button_to t("menus.show.delete"), menu_path(@menu), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: t("menus.show.confirm_delete") } } %>
  </div>
</div>

