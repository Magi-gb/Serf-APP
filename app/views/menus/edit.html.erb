<% content_for :title, t("menus.edit.title") %>

<%= render "shared/topbar", title: t("menus.edit.title"), subtitle: @menu.name do %>
  <%= link_to menu_path(@menu), class: "btn btn-ghost btn-sm" do %>
    <%= serf_icon(:chevron_left) %><%= t("menus.show.back") %>
  <% end %>
<% end %>

<div class="content">
  <div class="card">
    <div class="card-body">
      <%= render "form", menu: @menu %>
    </div>
  </div>
</div>
