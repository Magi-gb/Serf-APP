<div class="plats-selection-grid">
  <%= form.collection_check_boxes :plat_ids, plats, :id, :name do |b| %>
    <label class="checkbox-item">
      <%= b.check_box(class: "visually-hidden-checkbox") %>
      <div class="plat-card">
        <div class="plat-card-header">
          <h4 class="plat-card-name"><%= b.object.name %></h4>
        </div>
        <p class="plat-card-description"><%= truncate(b.object.description, length: 80) %></p>
      </div>
    </label>
  <% end %>
</div>
