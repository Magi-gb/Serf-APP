<% content_for :title, t("menus.index.title") %>
<% view = params[:view].presence || "list" %>

<%# DESIGN-GAP: design splits menus by type (Carta / Diari / Grup / Estacional)
    and shows publication state (publicat / esborrany / arxivat), per-restaurant
    assignment, validity dates and a "coverage" indicator. Our Menu model has only
    `name` and a dishes association — none of the above. Showing a simple list. %>
<%= render "shared/topbar", title: t("menus.index.title") do %>
  <%= form_with url: menus_path, method: :get, local: true, class: "search" do |f| %>
    <span class="search-icon"><%= serf_icon(:search) %></span>
    <%= f.search_field :search, value: params[:search], placeholder: t("menus.index.search_placeholder"), class: "input" %>
  <% end %>
  <% if current_user.admin? || current_user.kitchen_manager? %>
    <%= link_to new_menu_path, class: "btn btn-primary btn-sm" do %>
      <%= serf_icon(:plus) %><%= t("menus.index.new_menu") %>
    <% end %>
  <% end %>
<% end %>

<div class="content">
  <div class="toolbar">
    <div class="toolbar-filters">
      <span class="muted"><%= t("filters.dietary_restrictions") %>:</span>
      <%= safe_param_link(t("filters.safe_only"), request: request) %>
      <% @restrictions.each do |restriction| %>
        <%= exclude_param_link(restriction.name,
              target: restriction.id,
              exclude_param: "exclude_restrictions",
              request: request) %>
      <% end %>
      <% if params[:exclude_restrictions].present? || params[:safe_only].present? %>
        <%= link_to t("filters.clear"),
              menus_path(request.query_parameters.except(:exclude_restrictions, :include_restrictions, :safe_only)),
              class: "chip-clear" %>
      <% end %>
    </div>
    <%= view_toggle(view, request, default_view: "list") %>
  </div>

  <% if @menus.any? %>
    <% if view == "grid" %>
      <div class="grid grid-3">
        <% @menus.each do |menu| %>
          <%= link_to menu_path(menu), class: "card ingredient-grid-card" do %>
            <div class="row">
              <span class="avatar avatar-sm" style="--avatar-bg: oklch(0.6 0.13 <%= (menu.name.sum % 360) %>);">
                <%= serf_icon(:book) %>
              </span>
              <div class="grow">
                <div class="strong"><%= menu.name %></div>
                <div class="muted mt-1"><%= t("menus.show.dishes") %>: <%= menu.dishes.count %></div>
                <%= render "shared/restriction_tags",
                           restrictions: menu.all_restrictions,
                           wrapper_class: "wrap gap-1 mt-2" %>
              </div>
            </div>
          <% end %>
        <% end %>
      </div>
    <% else %>
      <div class="card">
        <% @menus.each do |menu| %>
          <%= link_to menu_path(menu), class: "card-row is-link" do %>
            <span class="avatar avatar-sm" style="--avatar-bg: oklch(0.6 0.13 <%= (menu.name.sum % 360) %>);">
              <%= serf_icon(:book) %>
            </span>
            <div class="grow">
              <div class="strong"><%= menu.name %></div>
              <div class="muted mt-2"><%= t("menus.show.dishes") %>: <%= menu.dishes.count %></div>
              <%= render "shared/restriction_tags",
                         restrictions: menu.all_restrictions,
                         wrapper_class: "wrap gap-1 mt-2" %>
            </div>
            <span class="muted"><%= serf_icon(:chevron) %></span>
          <% end %>
        <% end %>
      </div>
    <% end %>
  <% else %>
    <div class="empty-state"><%= t("menus.index.no_menus") %></div>
  <% end %>
</div>
