<% content_for :title, t("menus.index.title") %>

<div class="page-card">
  <div class="page-header">
    <h1 class="serf-page-title"><%= t("menus.index.title") %></h1>
  </div>

  <div class="index-toolbar">
    <% if current_user.admin? || current_user.kitchen_manager? %>
      <%= link_to t("menus.index.new_menu"), new_menu_path, class: "btn-pill btn-pill-primary" %>
    <% end %>
  </div>

  <% if @menus.any? %>
    <div class="list-card-group">
      <% @menus.each do |menu| %>
        <div class="list-card">
          <div class="list-card-info">
            <span class="list-card-title"><%= menu.name %></span>
          </div>

          <div class="detail-actions">
            <%= link_to t("menus.index.edit"), edit_menu_path(menu), class: "btn-primary" %>
            <%= button_to t("menus.index.delete"), menu_path(menu), method: :delete, class: "btn-danger", form: { data: { turbo_confirm: t("menus.index.confirm_delete") } } %>
          </div>
        </div>
      <% end %>
    </div>
  <% else %>
    <p class="empty-state"><%= t("menus.index.no_menus") %></p>
  <% end %>
</div>
